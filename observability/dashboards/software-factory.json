{
  "schemaVersion": "v6",
  "name": "software-factory-workers-and-ai-usage",
  "tags": [
    {
      "key": "application",
      "value": "software-factory"
    }
  ],
  "spec": {
    "display": {
      "name": "Software Factory \u2014 Workers and AI Usage",
      "description": "Worker activity, stage outcomes, model tokens, and estimated spend. Development data only. Missing usage/pricing is unknown; inspect traces for per-issue details. Synthetic smoke data uses a separate environment."
    },
    "duration": "1h",
    "refreshInterval": "30s",
    "variables": [],
    "panels": {
      "active": {
        "kind": "Panel",
        "spec": {
          "display": {
            "name": "Active tasks"
          },
          "plugin": {
            "kind": "signoz/TimeSeriesPanel",
            "spec": {
              "visualization": {
                "timePreference": "global_time"
              },
              "legend": {
                "position": "bottom"
              }
            }
          },
          "queries": [
            {
              "kind": "time_series",
              "spec": {
                "plugin": {
                  "kind": "signoz/BuilderQuery",
                  "spec": {
                    "name": "A",
                    "signal": "metrics",
                    "aggregations": [
                      {
                        "metricName": "factory.worker.active_tasks",
                        "timeAggregation": "max",
                        "spaceAggregation": "sum",
                        "reduceTo": "last"
                      }
                    ],
                    "filter": {
                      "expression": "service.name = 'software-factory' AND deployment.environment = 'development' AND stage = 'all'"
                    },
                    "groupBy": [
                      {
                        "name": "worker.name",
                        "fieldDataType": "string",
                        "fieldContext": "tag"
                      }
                    ]
                  }
                }
              }
            }
          ]
        }
      },
      "heartbeat": {
        "kind": "Panel",
        "spec": {
          "display": {
            "name": "Worker last heartbeat (Unix seconds)"
          },
          "plugin": {
            "kind": "signoz/TimeSeriesPanel",
            "spec": {
              "visualization": {
                "timePreference": "global_time"
              },
              "legend": {
                "position": "bottom"
              }
            }
          },
          "queries": [
            {
              "kind": "time_series",
              "spec": {
                "plugin": {
                  "kind": "signoz/BuilderQuery",
                  "spec": {
                    "name": "A",
                    "signal": "metrics",
                    "aggregations": [
                      {
                        "metricName": "factory.worker.heartbeat",
                        "timeAggregation": "max",
                        "spaceAggregation": "max",
                        "reduceTo": "last"
                      }
                    ],
                    "filter": {
                      "expression": "service.name = 'software-factory' AND deployment.environment = 'development'"
                    },
                    "groupBy": [
                      {
                        "name": "worker.name",
                        "fieldDataType": "string",
                        "fieldContext": "tag"
                      }
                    ]
                  }
                }
              }
            }
          ]
        }
      },
      "attempts": {

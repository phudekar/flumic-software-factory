# Runtime settings are in worker-config.yaml. Keep access credentials here.
GITHUB_TOKEN=your-fine-grained-github-token
OPENAI_API_KEY=your-openai-api-key
ANTHROPIC_API_KEY=
DEVELOPER_OPENAI_API_KEY=

# Optional operator-owned JSON registry, visible inside both API and reconciler.
# Requires explicit container mount/environment overrides; no effect merely in .env.
CONTROL_RUNTIME_TARGETS_FILE=

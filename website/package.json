    "check": "node scripts/check-site.mjs",
    "preview": "astro preview --host 127.0.0.1"
  },
  "dependencies": {
    "@astrojs/starlight": "0.42.6",
    "astro": "7.4.2"
  },
  "devDependencies": {
    "sharp": "0.35.5"
  }
}

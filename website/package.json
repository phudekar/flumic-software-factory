{
  "name": "flumic-ai-docs",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "engines": {
    "node": ">=22.23.4"
  },
  "scripts": {
    "prepare-content": "python3 scripts/prepare_content.py && node scripts/render-social-assets.mjs",
    "dev": "npm run prepare-content && astro dev --host 127.0.0.1",

# Existing installation: provide an API key with dashboard read/create/update access.
# SIGNOZ_API_KEY=
# Alternative: authenticate with your existing admin account through the session API.
# SIGNOZ_ADMIN_EMAIL=
# SIGNOZ_ADMIN_PASSWORD=
# Required only when that account belongs to multiple organizations.
# SIGNOZ_ORG_ID=
# Fresh installation with all fields empty: generate a local account once and
# save credentials in data/observability-bootstrap/login.json (ignored by Git).
